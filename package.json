{
  "name": "glimtra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop:dev": "node scripts/desktop.mjs dev",
    "desktop:build": "node scripts/desktop.mjs build",
    "check:rust": "node scripts/desktop.mjs --cargo check --manifest-path src-tauri/Cargo.toml --locked",
    "test:rust": "node scripts/desktop.mjs --cargo test --manifest-path src-tauri/Cargo.toml --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
